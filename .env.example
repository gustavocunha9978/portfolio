# URL pública do site (sem barra no final). Troque ao apontar o domínio próprio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcionais: sobrescrevem e-mail e WhatsApp de site.config.ts.
# Vazio ou inválido = o botão some do site.
# NEXT_PUBLIC_CONTACT_EMAIL=voce@exemplo.com
# NEXT_PUBLIC_WHATSAPP=5545999999999

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Para onde vão as mensagens do formulário de contato
CONTACT_TO_EMAIL=
# Remetente verificado no Resend (ex.: "Portfólio <contato@seudominio.com>").
# Sem domínio verificado, use "onboarding@resend.dev".
CONTACT_FROM_EMAIL=onboarding@resend.dev
